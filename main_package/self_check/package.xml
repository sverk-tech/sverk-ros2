<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>self_check</name>
  <version>0.1.0</version>
  <description>Диагностика дрона: нода-оркестратор self_check (пассивные и интерактивные проверки, ROS action API).</description>

  <maintainer email="petayyyymail@gmail.com">sverk</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>self_check_interfaces</depend>
  <depend>offboard_interfaces</depend>

  <!-- Пакеты подсистем, чьи типы сообщений/сервисов использует vision.py -->
  <!-- (aruco_det_loc) и sbc.py (led_interfaces); доступность самих     -->
  <!-- проверок на конкретной плате гейтится флагами features в профиле. -->
  <exec_depend>aruco_det_loc</exec_depend>
  <exec_depend>led_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
