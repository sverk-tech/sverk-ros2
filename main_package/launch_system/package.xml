<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>launch_system</name>
  <version>0.0.0</version>
  <description>Launch files for the complete system</description>
  <maintainer email="petayyyymail@gmail.com">Petayyy</maintainer>
  <license>Apache License 2.0</license>

  <!-- <buildtool_depend>ament_cmake</buildtool_depend> -->
  <!-- ros_gz_bridge — только для SITL (full_system_sitl.launch.py). На борту
       Gazebo нет; SITL-образ ставит ros-gzharmonic + libgz-*-dev явным блоком
       и скипает этот ключ в rosdep (scripts/sitl/Dockerfile.sitl). Держать его
       безусловным exec_depend — значит тянуть весь Ignition-стек в бортовой
       base через rosdep. -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>aruco_det_loc</exec_depend>
  <exec_depend>aruco_map</exec_depend>
  <exec_depend>offboard_control</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>
  <exec_depend>launch_yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>