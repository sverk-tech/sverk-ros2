<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pid_tuning_assistant</name>
  <version>0.1.0</version>
  <description>Read-only PX4 telemetry recorder and PID tuning advisor via uXRCE-DDS</description>
  <maintainer email="you@example.com">you</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>offboard_interfaces</exec_depend>
  <exec_depend>sverk_interfaces</exec_depend>

  <!-- Scientific stack + YAML: available as rosdep keys (system/pip wheels
       resolvable via `rosdep install`). Required by analyzer / model_estimator /
       hifi_analyzer / plant_estimator and the config loader in main.py. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- NOT declared here on purpose (no reliable rosdep key on Humble): the web
       layer needs fastapi, uvicorn[standard], python-multipart (mandatory for
       FastAPI UploadFile — /api/params and /api/ulog/upload fail without it),
       pyarrow (Parquet export) and the optional pyulog (ULog mode). These are
       pip-only; install them per setup.py `install_requires` / `extras_require`
       or the README "Prerequisites" block. See setup.py. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
